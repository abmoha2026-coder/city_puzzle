#! /bin/python3 
import random
from dataclasses import dataclass
from typing import List, Tuple, Optional
from collections import deque
import time

@dataclass
class CityPuzzle:
    grid: List[List[str]]  # Grid of city elements
    player_pos: Tuple[int, int]
    destination_pos: Tuple[int, int]
    difficulty: float  # 0.0 (easy) to 1.0 (hard)
    time_limit: int  # Seconds to complete

class CityPuzzleGame:
    def __init__(self):
        self.current_difficulty = 0.5
        self.puzzle = self.generate_puzzle(self.current_difficulty)

    def generate_puzzle(self, difficulty: float) -> CityPuzzle:
        """Generate a city-themed puzzle with adaptive difficulty."""
        size = 5 + int(difficulty * 10)  # Grid size scales with difficulty
        grid = [[' ' for _ in range(size)] for _ in range(size)]  # Initialize empty grid

        # Place buildings (obstacles)
        num_buildings = int(size * size * (0.1 + difficulty * 0.3))
        for _ in range(num_buildings):
            r, c = random.randint(0, size-1), random.randint(0, size-1)
            grid[r][c] = '#'  # Building

        # Place roads (traversable)
        for r in range(size):
            for c in range(size):
                if grid[r][c] == ' ':
                    grid[r][c] = '.'  # Road

        # Place player and destination
        player_pos = self.find_valid_position(grid, size)
        destination_pos = self.find_valid_position(grid, size, avoid=player_pos)

        grid[player_pos[0]][player_pos[1]] = 'P'  # Player
        grid[destination_pos[0]][destination_pos[1]] = 'D'  # Destination

        # Set time limit based on difficulty
        time_limit = max(10, int(60 - difficulty * 30))

        return CityPuzzle(grid, player_pos, destination_pos, difficulty, time_limit)

    def find_valid_position(self, grid: List[List[str]], size: int, avoid: Optional[Tuple[int, int]] = None) -> Tuple[int, int]:
        """Find a valid position for player/destination (on a road)."""
        while True:
            pos = (random.randint(0, size-1), random.randint(0, size-1))
            if grid[pos[0]][pos[1]] == '.' and (avoid is None or pos != avoid):
                return pos

    def is_solvable(self, grid: List[List[str]], player_pos: Tuple[int, int], destination_pos: Tuple[int, int]) -> bool:
        """Check if a path exists from player to destination using BFS."""
        size = len(grid)
        visited = [[False for _ in range(size)] for _ in range(size)]
        queue = deque([player_pos])
        visited[player_pos[0]][player_pos[1]] = True

        while queue:
            r, c = queue.popleft()
            if (r, c) == destination_pos:
                return True
            for dr, dc in [(0, 1), (1, 0), (0, -1), (-1, 0)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < size and 0 <= nc < size and not visited[nr][nc] and grid[nr][nc] != '#':
                    visited[nr][nc] = True
                    queue.append((nr, nc))
        return False

    def move_player(self, direction: str) -> bool:
        """Move player in a direction (WASD). Returns True if move is valid."""
        r, c = self.puzzle.player_pos
        dr, dc = 0, 0
        if direction == 'W': dr = -1
        elif direction == 'S': dr = 1
        elif direction == 'A': dc = -1
        elif direction == 'D': dc = 1
        else: return False

        new_r, new_c = r + dr, c + dc
        if 0 <= new_r < len(self.puzzle.grid) and 0 <= new_c < len(self.puzzle.grid[0]):
            if self.puzzle.grid[new_r][new_c] != '#':  # Not a building
                self.puzzle.grid[r][c] = '.'
                self.puzzle.grid[new_r][new_c] = 'P'
                self.puzzle.player_pos = (new_r, new_c)
                return True
        return False

    def check_win(self) -> bool:
        """Check if player reached the destination."""
        return self.puzzle.player_pos == self.puzzle.destination_pos

    def adjust_difficulty(self, time_taken: float) -> None:
        """Adjust difficulty based on player performance."""
        if time_taken < self.puzzle.time_limit * 0.5:
            self.current_difficulty = min(1.0, self.current_difficulty + 0.1)
        elif time_taken > self.puzzle.time_limit * 1.5:
            self.current_difficulty = max(0.0, self.current_difficulty - 0.1)
        self.puzzle = self.generate_puzzle(self.current_difficulty)

    def print_grid(self) -> None:
        """Print the current city grid state."""
        grid = [row[:] for row in self.puzzle.grid]  # Copy grid
        grid[self.puzzle.player_pos[0]][self.puzzle.player_pos[1]] = 'P'
        grid[self.puzzle.destination_pos[0]][self.puzzle.destination_pos[1]] = 'D'

        print(f"\nTime remaining: {max(0, self.puzzle.time_limit - int(time.time() - self.start_time))}s")
        print(f"Difficulty: {self.puzzle.difficulty:.1f}")
        for row in grid:
            print(" ".join(row))
        print(f"Player: {self.puzzle.player_pos}, Destination: {self.puzzle.destination_pos}")

    def start_timer(self):
        """Start the game timer."""
        self.start_time = time.time()

# Example Game Loop
if __name__ == "__main__":
    game = CityPuzzleGame()
    print("Welcome to City Puzzle! Navigate the city to reach your destination (D).")
    print("Use WASD to move. Avoid buildings (#).")
    game.start_timer()
    game.print_grid()

    while True:
        move = input("Your move (WASD, Q to quit): ").upper()
        if move == 'Q':
            break
        if game.move_player(move):
            game.print_grid()
            if game.check_win():
                time_taken = time.time() - game.start_time
                print(f"\nYou reached your destination in {time_taken:.1f} seconds!")
                game.adjust_difficulty(time_taken)
                game = CityPuzzleGame()  # New puzzle
                game.start_timer()
                game.print_grid()
        else:
            print("Invalid move! Try again.")
